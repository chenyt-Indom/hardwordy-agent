+    elapsed = max(0.0, time.time() - base)
+    h1 = OBSERVE_PENDING_HOURS * 3600.0
+    h24 = OBSERVE_CONFIRM_HOURS * 3600.0
+    # 为什么必须给部分信用（2026-11-23 实测修正）：
