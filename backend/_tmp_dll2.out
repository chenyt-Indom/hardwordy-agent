+                                   ("（另 %d 次护栏拦截，不计入分母）" % gate) if gate else "")))
     if marked:
         parts.append(("无幽灵率", 1 - ph / len(marked), 0.15,
@@ -422,6 +468,7 @@ def audit() -> dict:
